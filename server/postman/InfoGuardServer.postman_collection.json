    {
      "name": "Licenses",
      "item": [
        {
          "name": "My Licenses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('My licenses returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "if (Array.isArray(data) && data.length > 0) {",
                  "    const preferred = data.find(function (item) {",
                  "        return item.licenseKey === pm.collectionVariables.get('currentLicenseKey');",
                  "    }) || data[0];",
                  "    pm.collectionVariables.set('currentLicenseId', String(preferred.id || ''));",
                  "    pm.collectionVariables.set('currentLicenseKey', preferred.licenseKey || '');",
                  "    pm.collectionVariables.set('currentLicenseActive', String(preferred.active || false));",
                  "    pm.collectionVariables.set('currentLicenseBlocked', String(preferred.blocked || false));",
                  "    pm.collectionVariables.set('currentLicenseDeviceId', preferred.deviceId || '');",
                  "    pm.collectionVariables.set('currentLicenseExpiresAt', preferred.expiresAt || '');",
                  "} else {",
                  "    ['currentLicenseId', 'currentLicenseKey', 'currentLicenseActive', 'currentLicenseBlocked', 'currentLicenseDeviceId', 'currentLicenseExpiresAt'].forEach(function (key) {",
                  "        pm.collectionVariables.set(key, '');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/licenses/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "licenses",
                "me"
              ]
            },
            "description": "Lists licenses of the authenticated user and stores one of them into variables."
          },
          "response": []
        },
        {
          "name": "Activate Current License",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Activate license returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('currentTicketServerDate', data.ticket ? data.ticket.serverDate : '');",
                  "pm.collectionVariables.set('currentTicketLifetimeSeconds', data.ticket ? String(data.ticket.ticketLifetimeSeconds || '') : '');",
                  "pm.collectionVariables.set('currentTicketActivatedAt', data.ticket ? data.ticket.licenseActivatedAt : '');",
                  "pm.collectionVariables.set('currentTicketExpiresAt', data.ticket ? data.ticket.licenseExpiresAt : '');",
                  "pm.collectionVariables.set('currentTicketUserId', data.ticket ? String(data.ticket.userId || '') : '');",
                  "pm.collectionVariables.set('currentTicketDeviceId', data.ticket ? data.ticket.deviceId : '');",
                  "pm.collectionVariables.set('currentTicketBlocked', data.ticket ? String(data.ticket.blocked || false) : '');",
                  "pm.collectionVariables.set('currentTicketSignature', data.signature || '');",
                  "pm.collectionVariables.set('currentLicenseActive', 'true');",
                  "pm.collectionVariables.set('currentLicenseDeviceId', pm.collectionVariables.get('deviceId'));",
                  "pm.collectionVariables.set('currentLicenseExpiresAt', data.ticket ? data.ticket.licenseExpiresAt : '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licenseKey\": \"{{currentLicenseKey}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/licenses/activate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "licenses",
                "activate"
              ]
            },
            "description": "Activates the saved license key for the current device and stores the signed ticket into variables."
          },
          "response": []
        },
        {
          "name": "Current Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current ticket returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('currentTicketServerDate', data.ticket ? data.ticket.serverDate : '');",
                  "pm.collectionVariables.set('currentTicketLifetimeSeconds', data.ticket ? String(data.ticket.ticketLifetimeSeconds || '') : '');",
                  "pm.collectionVariables.set('currentTicketActivatedAt', data.ticket ? data.ticket.licenseActivatedAt : '');",
                  "pm.collectionVariables.set('currentTicketExpiresAt', data.ticket ? data.ticket.licenseExpiresAt : '');",
                  "pm.collectionVariables.set('currentTicketUserId', data.ticket ? String(data.ticket.userId || '') : '');",
                  "pm.collectionVariables.set('currentTicketDeviceId', data.ticket ? data.ticket.deviceId : '');",
                  "pm.collectionVariables.set('currentTicketBlocked', data.ticket ? String(data.ticket.blocked || false) : '');",
                  "pm.collectionVariables.set('currentTicketSignature', data.signature || '');",
                  "pm.collectionVariables.set('currentLicenseExpiresAt', data.ticket ? data.ticket.licenseExpiresAt : '');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/licenses/current?deviceId={{deviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "licenses",
                "current"
              ],
              "query": [
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            },
            "description": "Fetches the current signed ticket for the selected device."
          },
          "response": []
        }
