                  "});",
                  "",
                  "['accessToken', 'accessTokenExpiresAt', 'refreshToken', 'refreshTokenExpiresAt', 'currentLicenseId', 'currentLicenseKey', 'currentLicenseActive', 'currentLicenseBlocked', 'currentLicenseDeviceId', 'currentLicenseExpiresAt', 'currentTicketServerDate', 'currentTicketLifetimeSeconds', 'currentTicketActivatedAt', 'currentTicketExpiresAt', 'currentTicketUserId', 'currentTicketDeviceId', 'currentTicketBlocked', 'currentTicketSignature'].forEach(function (key) {",
